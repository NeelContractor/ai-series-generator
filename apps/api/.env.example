APP_NAME="AI Series Generator API"
DEBUG=false
DATABASE_URL="sqlite+aiosqlite:///./app.db"

MEDIA_DIR="./media"
MEDIA_URL_PREFIX="/media"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Docker Compose uses Postgres and Redis; local default is SQLite.
# DATABASE_URL="postgresql+asyncpg://seriesforge:seriesforge@localhost:5432/seriesforge"
REDIS_URL="redis://localhost:6379/0"

# Future media storage (MinIO/S3)
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="seriesforge"

COST_PER_KEYFRAME_USD=0
COST_PER_VIDEO_SECOND_USD=0
COST_PER_EPISODE_AUDIO_USD=0

RENDER_SECONDS_PER_KEYFRAME=3
RENDER_SECONDS_PER_VIDEO_SECOND=1.5
RENDER_SECONDS_PER_EPISODE_AUDIO=5
RENDER_ASSEMBLY_SECONDS=10

RENDER_STEP_DELAY_SECONDS=0.05
SSE_POLL_INTERVAL_SECONDS=0.25
